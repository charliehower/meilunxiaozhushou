.page-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #5D4037;
}

.total-count {
  font-size: 24rpx;
  color: #999;
}

.rating-item {
  padding: 24rpx;
}

.rating-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.rating-meal-info {
  flex: 1;
}

.meal-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.meal-date {
  font-size: 24rpx;
  color: #999;
}

.my-score {
  display: flex;
  align-items: baseline;
}

.score-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B35;
}

.score-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.rating-stars {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.rating-comment {
  font-size: 28rpx;
  color: #555;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.rating-time {
  font-size: 22rpx;
  color: #ccc;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 10rpx;
}
