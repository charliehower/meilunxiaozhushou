.date-picker {
  margin-bottom: 20rpx;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}

.picker-value {
  font-size: 28rpx;
  color: #FF6B35;
  padding: 8rpx 20rpx;
  border: 1rpx solid #FF6B35;
  border-radius: 8rpx;
}

.quick-dates {
  display: flex;
  margin-top: 16rpx;
  gap: 12rpx;
}

.quick-date {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #666;
}

.quick-date.active {
  background: #FF6B35;
  color: #fff;
}

.period-section {
  margin-bottom: 16rpx;
}

.period-header {
  padding: 10rpx 0;
}

.period-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}

.meal-card {
  display: flex;
  align-items: center;
}

.meal-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.meal-info {
  flex: 1;
  margin-left: 16rpx;
}

.meal-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.meal-rating {
  display: flex;
  align-items: center;
}

.stars {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #FFB800;
}
