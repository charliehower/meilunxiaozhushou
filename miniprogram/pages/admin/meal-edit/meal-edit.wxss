.form {
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.period-options {
  display: flex;
  gap: 16rpx;
}

.period-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #666;
}

.period-opt.active {
  background: #FF6B35;
  color: #fff;
}

.form-picker {
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}

.image-upload {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f9f9f9;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.submit-btn {
  margin: 0 24rpx 40rpx;
  width: calc(100% - 48rpx);
}
