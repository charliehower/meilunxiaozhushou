<view class="container">
  <view class="form card">
    <!-- 餐品名称 -->
    <view class="form-item">
      <text class="form-label">餐品名称</text>
      <input class="form-input" placeholder="请输入餐品名称" value="{{name}}" bindinput="onNameInput" />
    </view>

    <!-- 餐次选择 -->
    <view class="form-item">
      <text class="form-label">餐次</text>
      <view class="period-options">
        <view class="period-opt {{period === 'breakfast' ? 'active' : ''}}" bindtap="setPeriod" data-period="breakfast">
          🌅 早餐
        </view>
        <view class="period-opt {{period === 'lunch' ? 'active' : ''}}" bindtap="setPeriod" data-period="lunch">
          ☀️ 午餐
        </view>
        <view class="period-opt {{period === 'dinner' ? 'active' : ''}}" bindtap="setPeriod" data-period="dinner">
          🌙 晚餐
        </view>
      </view>
    </view>

    <!-- 日期选择 -->
    <view class="form-item">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="form-picker">{{date || '请选择日期'}}</view>
      </picker>
    </view>

    <!-- 图片上传 -->
    <view class="form-item">
      <text class="form-label">餐品照片</text>
      <view class="image-upload" bindtap="chooseImage">
        <image wx:if="{{imageUrl}}" class="preview-img" src="{{imageUrl}}" mode="aspectFill"></image>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">📷</text>
          <text class="upload-text">点击上传照片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="btn-primary submit-btn" bindtap="submitMeal" disabled="{{!canSubmit}}">
    {{isEdit ? '保存修改' : '添加餐品'}}
  </button>
</view>
