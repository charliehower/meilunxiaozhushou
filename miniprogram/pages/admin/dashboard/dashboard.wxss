.overview {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B35;
}

.overview-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.overview-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #f0f0f0;
}

.actions {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #5D4037;
}

.section-header {
  padding: 16rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
}

.meal-manage-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.manage-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.manage-info {
  flex: 1;
  margin-left: 16rpx;
}

.manage-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.manage-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.manage-score {
  font-size: 24rpx;
  color: #FFB800;
}

.manage-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-edit {
  font-size: 26rpx;
  color: #FF6B35;
  padding: 6rpx 16rpx;
  border: 1rpx solid #FF6B35;
  border-radius: 8rpx;
  text-align: center;
}

.action-delete {
  font-size: 26rpx;
  color: #e53935;
  padding: 6rpx 16rpx;
  border: 1rpx solid #e53935;
  border-radius: 8rpx;
  text-align: center;
}
