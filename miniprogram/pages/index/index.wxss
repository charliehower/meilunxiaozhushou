.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 24rpx 20rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  color: #fff;
}

.date-info {
  display: flex;
  flex-direction: column;
}

.date-text {
  font-size: 36rpx;
  font-weight: 600;
}

.weekday-text {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.admin-entry {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.admin-icon {
  margin-right: 6rpx;
}

.period-section {
  margin-bottom: 24rpx;
}

.period-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx 10rpx;
}

.period-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
}

.period-count {
  font-size: 24rpx;
  color: #999;
}

.meal-list {
  padding: 0 24rpx;
}

.meal-card {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  align-items: center;
}

.meal-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.meal-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.meal-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.meal-rating {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.stars {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.rating-text {
  font-size: 26rpx;
  color: #FFB800;
  font-weight: 500;
}

.rating-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 6rpx;
}

.empty-period {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.empty-text {
  color: #ccc;
  font-size: 28rpx;
}
